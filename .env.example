# Database (PostgreSQL — use Neon.tech for free hosted DB)
DATABASE_URI=postgresql://user:password@host/dbname?sslmode=require

# Payload CMS
PAYLOAD_SECRET=generate-with-openssl-rand-hex-32

# Site URL (update after first deploy)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# S3 Storage (optional — media uploads)
S3_BUCKET=
S3_PUBLIC_BASE_URL=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email (SMTP — optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com
ADMIN_EMAIL=admin@example.com
