# Database (Neon / Postgres)
DATABASE_URI=postgresql://user:password@host:5432/dbname?sslmode=require

# Payload CMS
PAYLOAD_SECRET=your-payload-secret-min-32-chars

# AWS S3
S3_BUCKET=amzn-dgmotors
S3_REGION=eu-north-1
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_PUBLIC_BASE_URL=https://amzn-dgmotors.s3.eu-north-1.amazonaws.com

# S3 endpoint (optional — only for S3-compatible services like MinIO)
# S3_ENDPOINT=https://s3.eu-north-1.amazonaws.com
# S3_FORCE_PATH_STYLE=false

# SMTP (optional — email sending is skipped if not set)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user
# SMTP_PASS=password
# EMAIL_FROM=noreply@example.com
# ADMIN_EMAIL=admin@example.com

# Site URL (optional)
# NEXT_PUBLIC_SITE_URL=https://dgmotors.ru
